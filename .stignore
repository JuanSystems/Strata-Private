**.log
(?d).git
(?d).git/**
build-spill\
.sync-conflict-20261026-160820-SYCOBEM.gitignore

# Syncthing: only source belongs across machines. Everything below is
# machine-generated, machine-specific or too large to replicate.

# Build trees and installer outputs (any name, any depth)
build*\
engine\
engine-cuda12\
dist\
pack\
packs\
models\
mtp\
logs\
.run-*\

# Toolchains and caches
.venv\
.ccache\
.rocm-win\
__pycache__\
.pytest_cache\
node_modules\

# Local tool state and Syncthing itself
.strata-mcp\
.stfolder\
.stversions\
(?d).sync-conflict-*

# Vendored build of llama.cpp (regenerated by setup.py)
third_party/llama.cpp\

# Large generated binaries and diagnostics
bench/micro\
*.pyc
*.sqlite
*.npz
*.occ1
*.nsys-rep
*.done

# setup.py launch scripts and local runtime config written on this machine
run-*.bat
run-*.sh
build-strata*.bat
build-vision*.bat
strata-*.json
strata-*.log
td.log

# Downloaded archives (hundreds of MB, fetched again by setup.py)
third_party/*.zip

# Generated benchmark models (~113 MB, regenerated with tools/make_tiny_model.py)
bench/tiny-*.gguf
bench/wide-*.gguf

# Per-machine editor state
.vscode\
.idea\
.cursor\
